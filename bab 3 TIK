<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kuis Interaktif TIK Kelas 8 - Ibu Bertaulina Simatupang</title>
    <style>
        :root {
            --primary: #4a90e2;
            --secondary: #50e3c2;
            --dark: #2c3e50;
            --light: #f8f9fa;
            --success: #2ecc71;
            --danger: #e74c3c;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #eef2f5;
            color: var(--dark);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 15px;
        }

        .container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 650px;
            padding: 25px;
            transition: all 0.3s ease;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 2px solid var(--light);
            padding-bottom: 15px;
        }

        header h1 {
            font-size: 1.5rem;
            color: var(--primary);
            margin-bottom: 5px;
        }

        header p {
            font-size: 0.9rem;
            color: #7f8c8d;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
        }

        input[type="text"] {
            width: 100%;
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="text"]:focus {
            border-color: var(--primary);
        }

        .btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-size: 1rem;
            cursor: pointer;
            width: 100%;
            font-weight: bold;
            transition: background 0.2s;
        }

        .btn:hover {
            background: #357abd;
        }

        .btn:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

        .quiz-body {
            display: none;
        }

        .question {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .options {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 20px;
        }

        .option-btn {
            background: var(--light);
            border: 2px solid #e2e8f0;
            padding: 12px 15px;
            border-radius: 8px;
            text-align: left;
            cursor: pointer;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .option-btn:hover:not([disabled]) {
            border-color: var(--primary);
            background: #ebf5ff;
        }

        .option-btn.correct {
            background: #d4edda;
            border-color: var(--success);
            color: #155724;
        }

        .option-btn.wrong {
            background: #f8d7da;
            border-color: var(--danger);
            color: #721c24;
        }

        .feedback {
            margin-top: 15px;
            padding: 10px 15px;
            border-radius: 6px;
            font-size: 0.9rem;
            display: none;
        }

        .feedback.correct {
            background: #d4edda;
            color: #155724;
        }

        .feedback.wrong {
            background: #f8d7da;
            color: #721c24;
        }

        .progress-bar {
            height: 8px;
            background: #e2e8f0;
            border-radius: 4px;
            margin-bottom: 20px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--primary);
            width: 0%;
            transition: width 0.3s ease;
        }

        .result-screen {
            display: none;
            text-align: center;
        }

        .score-box {
            font-size: 3rem;
            font-weight: bold;
            color: var(--primary);
            margin: 15px 0;
        }

        .status-msg {
            margin-top: 15px;
            font-size: 0.9rem;
            color: #555;
        }

        @media (max-width: 480px) {
            .container {
                padding: 15px;
            }
            header h1 {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Kuis Informatika Kelas 8</h1>
        <p>Materi TIK: Pengolah Kata, Lembar Kerja, & Presentasi</p>
    </header>

    <!-- Halaman Awal: Data Siswa -->
    <div id="start-screen">
        <div class="form-group">
            <label for="student-name">Nama Lengkap Siswa:</label>
            <input type="text" id="student-name" placeholder="Masukkan nama lengkap...">
        </div>
        <div class="form-group">
            <label for="student-class">Kelas:</label>
            <input type="text" id="student-class" placeholder="Contoh: 8A">
        </div>
        <button class="btn" onclick="startQuiz()">Mulai Kuis</button>
    </div>

    <!-- Halaman Kuis -->
    <div id="quiz-screen" class="quiz-body">
        <div class="progress-bar">
            <div id="progress-fill" class="progress-fill"></div>
        </div>
        <div class="question" id="question-text">Pertanyaan akan muncul di sini...</div>
        <div class="options" id="options-container"></div>
        <div id="feedback" class="feedback"></div>
        <button id="next-btn" class="btn" style="display: none; margin-top: 15px;" onclick="nextQuestion()">Soal Berikutnya</button>
    </div>

    <!-- Halaman Hasil / Nilai -->
    <div id="result-screen" class="result-screen">
        <h2>Kuis Selesai!</h2>
        <p>Terima kasih telah menyelesaikan kuis ini.</p>
        <div class="score-box" id="final-score">0</div>
        <p id="score-details"></p>
        
        <button id="send-btn" class="btn" style="margin-top: 20px;" onclick="sendToGoogleSheet()">Kirim / Tautkan Hasil ke Google Sheets</button>
        <div id="status-msg" class="status-msg"></div>
    </div>
</div>

<script>
    // Konfigurasi Webhook Google Apps Script (Ganti URL di bawah ini dengan URL Webhook milik Anda)
    const GOOGLE_SCRIPT_URL = "URL_WEBHOOK_GOOGLE_APPS_SCRIPT_ANDA";

    // Bank Soal Materi TIK Kelas 8
    const quizData = [
        {
            question: "Fitur pada aplikasi pengolah kata (Google Docs / MS Word) yang berfungsi untuk membuat daftar isi otomatis berdasarkan judul bab/subbab adalah...",
            options: ["Header & Footer", "Table of Contents", "Indentation", "Mail Merge"],
            answer: 1,
            explanation: "Table of Contents berfungsi secara otomatis menyusun daftar isi menggunakan hirarki Heading."
        },
        {
            question: "Di aplikasi pengolah lembar kerja (Google Sheets / MS Excel), rumus yang digunakan untuk menghitung nilai rata-rata dari sekelompok data sel adalah...",
            options: ["=SUM()", "=COUNT()", "=AVERAGE()", "=IF()"],
            answer: 2,
            explanation: "=AVERAGE() digunakan untuk menghitung rata-rata, sedangkan =SUM() untuk penjumlahan total."
        },
        {
            question: "Fitur pada aplikasi presentasi (Google Slides / MS PowerPoint) yang digunakan untuk merancang elemen visual dasar (seperti tata letak, warna, dan font) secara konsisten pada seluruh slide adalah...",
            options: ["Transition", "Animation", "Slide Master", "Presenter View"],
            answer: 2,
            explanation: "Slide Master mengatur template dan konsistensi elemen visual di seluruh lembar kerja slide."
        },
        {
            question: "Perpindahan visual dari satu slide ke slide berikutnya saat presentasi dijalankan disebut...",
            options: ["Animasi (Animation)", "Transisi (Transition)", "Format Painter", "Hyperlink"],
            answer: 1,
            explanation: "Transisi adalah efek perpindahan antarslide, sedangkan Animasi adalah efek pada objek di dalam slide."
        },
        {
            question: "Pertemuan antara kolom (huruf) dan baris (angka) pada aplikasi pengolah lembar kerja dinamakan...",
            options: ["Range", "Sel (Cell)", "Chart", "Workbook"],
            answer: 1,
            explanation: "Pertemuan antara kolom dan baris membentuk Sel (contoh: A1, B3)."
        }
    ];

    let currentQuestion = 0;
    let score = 0;
    let studentData = { name: "", class: "" };

    function startQuiz() {
        const nameInput = document.getElementById("student-name").value.trim();
        const classInput = document.getElementById("student-class").value.trim();

        if (!nameInput || !classInput) {
            alert("Harap isi Nama Lengkap dan Kelas terlebih dahulu!");
            return;
        }

        studentData.name = nameInput;
        studentData.class = classInput;

        document.getElementById("start-screen").style.display = "none";
        document.getElementById("quiz-screen").style.display = "block";
        
        loadQuestion();
    }

    function loadQuestion() {
        const q = quizData[currentQuestion];
        document.getElementById("question-text").innerText = `${currentQuestion + 1}. ${q.question}`;
        
        const optionsContainer = document.getElementById("options-container");
        optionsContainer.innerHTML = "";

        const feedbackEl = document.getElementById("feedback");
        feedbackEl.style.display = "none";
        document.getElementById("next-btn").style.display = "none";

        // Update progress bar
        const progress = ((currentQuestion) / quizData.length) * 100;
        document.getElementById("progress-fill").style.width = `${progress}%`;

        q.options.forEach((opt, index) => {
            const btn = document.createElement("button");
            btn.className = "option-btn";
            btn.innerText = opt;
            btn.onclick = () => selectOption(index, btn);
            optionsContainer.appendChild(btn);
        });
    }

    function selectOption(selectedIndex, selectedBtn) {
        const q = quizData[currentQuestion];
        const buttons = document.querySelectorAll(".option-btn");
        const feedbackEl = document.getElementById("feedback");

        // Nonaktifkan seluruh tombol setelah dipilih
        buttons.forEach(btn => btn.disabled = true);

        if (selectedIndex === q.answer) {
            score++;
            selectedBtn.classList.add("correct");
            feedbackEl.className = "feedback correct";
            feedbackEl.innerText = `Jawaban Benar! ${q.explanation}`;
        } else {
            selectedBtn.classList.add("wrong");
            buttons[q.answer].classList.add("correct");
            feedbackEl.className = "feedback wrong";
            feedbackEl.innerText = `Jawaban Salah. ${q.explanation}`;
        }

        feedbackEl.style.display = "block";
        document.getElementById("next-btn").style.display = "block";
    }

    function nextQuestion() {
        currentQuestion++;
        if (currentQuestion < quizData.length) {
            loadQuestion();
        } else {
            showResult();
        }
    }

    function showResult() {
        document.getElementById("quiz-screen").style.display = "none";
        document.getElementById("result-screen").style.display = "block";

        const finalScoreVal = Math.round((score / quizData.length) * 100);
        document.getElementById("final-score").innerText = finalScoreVal;
        document.getElementById("score-details").innerText = `Anda menjawab benar ${score} dari ${quizData.length} soal.`;
    }

    function sendToGoogleSheet() {
        const sendBtn = document.getElementById("send-btn");
        const statusMsg = document.getElementById("status-msg");

        if (GOOGLE_SCRIPT_URL === "URL_WEBHOOK_GOOGLE_APPS_SCRIPT_ANDA" || !GOOGLE_SCRIPT_URL) {
            alert("Sistem belum dihubungkan dengan Google Sheets (URL Webhook belum diatur oleh guru). Nilai tidak tersimpan secara otomatis.");
            return;
        }

        sendBtn.disabled = true;
        statusMsg.style.color = "#333";
        statusMsg.innerText = "Sedang mengirim data...";

        const payload = {
            nama: studentData.name,
            kelas: studentData.class,
            skor: Math.round((score / quizData.length) * 100),
            waktu: new Date().toLocaleString("id-ID")
        };

        fetch(GOOGLE_SCRIPT_URL, {
            method: "POST",
            mode: "no-cors",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
        })
        .then(() => {
            statusMsg.style.color = "green";
            statusMsg.innerText = "✓ Hasil berhasil dikirim dan tersimpan di Google Sheets!";
        })
        .catch(error => {
            console.error("Error:", error);
            statusMsg.style.color = "red";
            statusMsg.innerText = "Gagal mengirim data. Periksa koneksi internet Anda.";
            sendBtn.disabled = false;
        });
    }
</script>
</body>
</html>
